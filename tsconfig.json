{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"noImplicitAny": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"constants/*": [
				"./constants/*",
			],
			"core/*": [
				"./core/*",
			],
			"datesets/*": [
				"./datesets/*",
			],
			"dtos/*": [
				"./dtos/*",
			],
			"enums/*": [
				"./enums/*",
			],
			"fixtures/*": [
				"./fixtures/*",
			],
			"formulas/*": [
				"./formulas/*",
			],
			"logger/*": [
				"./logger/*",
			],
			"pages/*": [
				"./pages/*",
			],
			"base/*": [
				"pages/base/*",
			],
			"components/*": [
				"pages/components/*",
			],
			"modals/*": [
				"pages/modals/*",
			],
			"support/*": [
				"./support/*",
			],
			"tests/*": [
				"./tests/*",
			]
		}
	}
}